# Reckon Protocol Environment Configuration (BNB Smart Chain Mainnet - chainId 56)

# Canonical Public Site URL (used for SEO metadataBase, sitemap.xml, robots.txt, and Open Graph cards)
NEXT_PUBLIC_APP_URL=https://reckon.markets

# Deployed Contract Addresses (updated automatically via `npm run sync:deployment`)
# RECKON_SYNC:ENV_START
NEXT_PUBLIC_RECKON_CORE_ADDRESS=0x0000000000000000000000000000000000000000
RECKON_CORE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RECKON_SIGNAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
RECKON_SIGNAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# RECKON_SYNC:ENV_END

# Optional Dedicated BSC Mainnet RPC (falls back to public BSC dataseed pool)
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# WalletConnect Cloud / Reown Project ID (https://cloud.reown.com)
# Enables WalletConnect v2 QR & mobile deep-links alongside injected browser extensions
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Production SignalStore Persistence (Upstash Redis REST)
# When both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are set, SignalStore
# switches automatically from local EncryptedJsonSignalStore to UpstashRedisSignalStore.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RECKON_REDIS_PREFIX=reckon:v1

# 32+ char secret for AES-256-GCM encryption of paid signal theses at rest
RECKON_STORE_ENCRYPTION_KEY=

# Self-Hosted x402 v2 Relayer (Day 1 default mode; sponsors gas for USD1/U/USDT/USDC settlements)
X402_RELAYER_PRIVATE_KEY=
X402_FACILITATOR_SIGNER_ADDRESS=

# Optional Binance B402 Hosted Facilitator Mode (auto-enabled when all 3 are set)
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY_B64=
B402_BASE_URL=https://b402.binance.com
B402_SIGNER_ADDRESS=
